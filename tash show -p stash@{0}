[32m+[m[32m    "    for ch in range(N_CH)\n",[m
[32m+[m[32m    "])\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "# =============================================================================\n",[m
[32m+[m[32m    "# SHORT CHECK\n",[m
