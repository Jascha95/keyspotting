[32m+[m[32m    "        f\"Inh events={inh_event_counts[ch]:5d} | \"\n",[m
[32m+[m[32m    "        f\"Match score={match_scores[ch]:10.6f} | \"\n",[m
[32m+[m[32m    "        f\"Inh score={inh_scores[ch]:10.6f}\"\n",[m
[32m+[m[32m    "    )\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "print(f\"\\nTotal recorded events: {len(events)}\")\n",[m
