[32m+[m[32m    "    hi = lo + MATCH_CH\n",[m
[32m+[m[32m    "    mask = (spike_core == NETWORK_CORE) & (spike_nrn >= lo) & (spike_nrn < hi)\n",[m
[32m+[m[32m    "    return spike_t[mask], spike_nrn[mask]\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "def get_inh_spikes(ch):\n",[m
[32m+[m[32m    "    lo = INH_START_ID + ch * INH_CH\n",[m
[32m+[m[32m    "    hi = lo + INH_CH\n",[m
[32m+[m[32m    "    mask = (spike_core == NETWORK_CORE) & (spike_nrn >= lo) & (spike_nrn < hi)\n",[m
[32m+[m[32m    "    return spike_t[mask], spike_nrn[mask]\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "# =============================================================================\n",[m
[32m+[m[32m    "# FIRING-RATE ESTIMATOR\n",[m
[32m+[m[32m    "# =============================================================================\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "bins = int(D * fs)\n",[m
[32m+[m[32m    "t_axis = np.arange(bins) / fs\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "x_kernel = np.arange(int(-0.5 * fs), int(0.5 * fs)) / fs\n",[m
[32m+[m[32m    "gauss = np.exp(-(x_kernel**2) / (2 * sigma**2))\n",[m
[32m+[m[32m    "gauss /= gauss.sum()\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "def population_rate(times, n_neurons):\n",[m
[32m+[m[32m    "    activity = np.zeros(bins, dtype=float)\n",[m
[32m+[m[32m    "    indices_rate = (np.asarray(times) * fs).astype(int)\n",[m
[32m+[m[32m    "    indices_rate = indices_rate[(indices_rate >= 0) & (indices_rate < bins)]\n",[m
[32m+[m[32m    "    np.add.at(activity, indices_rate, 1.0)\n",[m
[32m+[m[32m    "    return np.convolve(activity, gauss, mode=\"same\") * fs / n_neurons\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "# =============================================================================\n",[m
[32m+[m[32m    "# CHANNEL ACTIVITY\n",[m
[32m+[m[32m    "# =============================================================================\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "match_rates = np.asarray([\n",[m
[32m+[m[32m    "    population_rate(get_match_spikes(ch)[0], MATCH_CH)\n",[m
[32m+[m[32m    "    for ch in range(N_CH)\n",[m
[32m+[m[32m    "])\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "inh_rates = np.asarray([\n",[m
[32m+[m[32m    "    population_rate(get_inh_spikes(ch)[0], INH_CH)\n",[m
[32m+[m[32m    "    for ch in range(N_CH)\n",[m
[32m+[m[32m    "])\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "match_event_counts = np.asarray([\n",[m
[32m+[m[32m    "    len(get_match_spikes(ch)[0])\n",[m
[32m+[m[32m    "    for ch in range(N_CH)\n",[m
[32m+[m[32m    "])\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "inh_event_counts = np.asarray([\n",[m
[32m+[m[32m    "    len(get_inh_spikes(ch)[0])\n",[m
[32m+[m[32m    "    for ch in range(N_CH)\n",[m
[32m+[m[32m    "])\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "# =============================================================================\n",[m
[32m+[m[32m    "# INTEGRATED ACTIVITY SCORES\n",[m
[32m+[m[32m    "# =============================================================================\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "match_scores = np.asarray([\n",[m
[32m+[m[32m    "    np.trapz(match_rates[ch], t_axis)\n",[m
[32m+[m[32m    "    for ch in range(N_CH)\n",[m
[32m+[m[32m    "])\n",[m
[32m+[m[32m    "\n",[m
[32m+[m[32m    "inh_scores = np.asarray([\n",[m
